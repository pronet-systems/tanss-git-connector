<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- IDE0005 (unbenutzte usings) wirkt beim Build nur mit Dokumentationsdatei. CS1591 dafuer stumm. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;CA1031;CS1591</NoWarn>
    <Company>ProNet Systems GmbH</Company>
    <Product>TANSS Git-Connector</Product>
    <Copyright>Copyright (c) 2026 ProNet Systems GmbH</Copyright>
    <!-- Eine Quelle der Wahrheit fuer die Fassung. Alles andere leitet sich hiervon ab. -->
    <Version>0.1.0</Version>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Match($(Version), "^\d+(\.\d+){0,2}").Value).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Deutsche Benutzertexte, daher keine InvariantGlobalization. -->
  </PropertyGroup>
</Project>
