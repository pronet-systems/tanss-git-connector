<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>TanssGitConnector.Storage.Tests</RootNamespace>
    <!-- CA1707: Testnamen tragen Unterstriche, weil sie Saetze sind und nicht Bezeichner. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Die Beispielkonfiguration wird mitgeprueft: Eine Vorlage, die in der Anleitung steht
         und sich nicht laden laesst, ist schlimmer als keine. -->
    <None Include="..\..\config.example.json" Link="config.example.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TanssGitConnector.Storage\TanssGitConnector.Storage.csproj" />
  </ItemGroup>
</Project>
